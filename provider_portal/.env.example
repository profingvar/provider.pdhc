# provider.pdhc — example environment file
# Copy to .env and fill values. Never commit the real .env.

# Provider Portal Configuration
FLASK_APP=
FLASK_ENV=
SECRET_KEY=

# PostgreSQL (port 9071)
DATABASE_URL=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Bootstrap superuser API key (first run only)
BOOTSTRAP_API_KEY=
BOOTSTRAP_PROVIDER_NAME=

# Flask
FLASK_PORT=

# Instance identity (one provider per instance)
PROVIDER_GUID=
PROVIDER_NAME=Provider1

# Inbound push reception (shared secret — must match PAT push_auth_key in request.pdhc)
PUSH_SECRET=

# Upstream request service
REQUEST_SERVICE_URL=
SSO_API_KEY=

# Sync settings
SYNC_INTERVAL_SECONDS=
SYNC_ENABLED=
